<Application x:Class="ScreenCap.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BgBrush" Color="#0E0F12" />
            <SolidColorBrush x:Key="PanelBrush" Color="#17181C" />
            <SolidColorBrush x:Key="Panel2Brush" Color="#24262C" />
            <SolidColorBrush x:Key="Panel3Brush" Color="#2F3138" />
            <SolidColorBrush x:Key="StrokeBrush" Color="#2A2C33" />
            <SolidColorBrush x:Key="TextBrush" Color="#E8E9EE" />
            <SolidColorBrush x:Key="DimTextBrush" Color="#9A9CA6" />
            <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#5B9BFF" />
            <SolidColorBrush x:Key="DangerBrush" Color="#E5394A" />

            <Style x:Key="BaseButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource Panel3Brush}" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.68" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.38" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" BasedOn="{StaticResource BaseButton}" TargetType="Button">
                <Setter Property="Background" Value="#2563EB" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="DangerButton" BasedOn="{StaticResource BaseButton}" TargetType="Button">
                <Setter Property="Background" Value="#E5394A" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="GhostButton" BasedOn="{StaticResource BaseButton}" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            </Style>

            <Style x:Key="IconButton" BasedOn="{StaticResource BaseButton}" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="28" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="BarButton" BasedOn="{StaticResource BaseButton}" TargetType="Button">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="4,0,0,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
