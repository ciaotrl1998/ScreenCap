<Window x:Class="ScreenCap.Capture.ControlBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenCap"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight"
        Opacity="0"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#B9BBC4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F0131418"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="9"
            Padding="10,8">
        <Grid>
            <StackPanel x:Name="ReadyPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="#E5394A" VerticalAlignment="Center" Margin="2,0,10,0" />

                <Border Width="104"
                        Height="32"
                        CornerRadius="16"
                        Background="#2A2C33"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <Border x:Name="FormatThumb"
                                Width="52"
                                Height="32"
                                CornerRadius="16"
                                Background="#E5394A"
                                HorizontalAlignment="Left">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="FormatThumbTransform" X="0" />
                            </Border.RenderTransform>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="GifButton"
                                    Grid.Column="0"
                                    Content="GIF"
                                    Style="{StaticResource SegmentButton}"
                                    Click="Gif_Click" />
                            <Button x:Name="VideoButton"
                                    Grid.Column="1"
                                    Content="视频"
                                    Style="{StaticResource SegmentButton}"
                                    Click="Video_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <Button Content="开始录制"
                        Style="{StaticResource DangerButton}"
                        Width="100"
                        Height="32"
                        Padding="0"
                        FontSize="12"
                        Click="Start_Click" />
                <Button Content="取消"
                        Style="{StaticResource GhostButton}"
                        Width="48"
                        Height="32"
                        Padding="0"
                        FontSize="12"
                        Margin="4,0,0,0"
                        Click="Cancel_Click" />
            </StackPanel>

            <StackPanel x:Name="RecordingPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <Ellipse Width="8" Height="8" Fill="#E5394A" VerticalAlignment="Center" Margin="2,0,10,0" />
                <Border Width="104"
                        Height="32"
                        Margin="0,0,8,0"
                        Background="Transparent"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TimerText"
                               Text="00:00:00"
                               Foreground="#F2F3F5"
                               FontSize="12"
                               FontFamily="Consolas"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <Button x:Name="StopButton"
                        Content="停止录制"
                        Style="{StaticResource DangerButton}"
                        Width="100"
                        Height="32"
                        Padding="0"
                        FontSize="12"
                        Click="Stop_Click" />
                <Button x:Name="DiscardButton"
                        Content="取消"
                        Style="{StaticResource GhostButton}"
                        Width="48"
                        Height="32"
                        Padding="0"
                        FontSize="12"
                        Margin="4,0,0,0"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
