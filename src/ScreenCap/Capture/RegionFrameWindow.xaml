<Window x:Class="ScreenCap.Capture.RegionFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenCap"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Opacity="0"
        Cursor="Arrow"
        Focusable="True"
        UseLayoutRounding="True">
    <Canvas x:Name="Root" Background="Transparent">
        <Rectangle x:Name="Shade" Fill="#08000000" IsHitTestVisible="False" />
        <Border x:Name="Frame" BorderBrush="#4C9BFF" BorderThickness="2" Background="Transparent" IsHitTestVisible="False" />
    </Canvas>
</Window>
